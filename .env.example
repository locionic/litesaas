# SQLite Database File Location (created automatically)
DATABASE_URL=data/app.db

# App Domain — the origin Stripe returns a customer to after they pay, so it
# must be your real public origin on a live deployment. Next.js inlines
# NEXT_PUBLIC_* at BUILD time: set it before building, not before starting.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Billing Provider: 'stripe' (default) or 'lemonsqueezy'
BILLING_PROVIDER=stripe

# Seed the demo@litesaas.dev / password123 account (Pro plan). Only needed for a
# hosted public demo. Ignored in development, where it is always seeded.
# Leave unset in production — this account has a published password.
SEED_DEMO_USER=false

# Set to `true` ONLY when a reverse proxy (nginx, Caddy, Traefik, a cloud load
# balancer) sits in front of the app and sets or appends X-Forwarded-For. That is
# the signal the sign-in and signup throttles use to key on the caller's network.
#
# Off by default, and the default is the safe one. With no proxy in front, the
# header is not evidence of anything: Next.js fills it from the socket address
# only when the client left it absent, so a client that does send one keeps the
# value it chose, and a per-IP limit keyed on that is a limit the caller can
# switch off. The other direction is worse — `docker compose up -d` publishes
# the port, so every visitor arrives as the same address, and a limit keyed on it
# is a global limit: ten wrong guesses from one stranger then refuse the correct
# password to everyone for the length of the window.
#
# Leaving it off does NOT remove password protection. The tighter per-account
# limit still applies, and it is keyed on the submitted email address.
TRUST_PROXY=false

# Stripe Payments & Webhooks (Optional — but read the note, all three are needed
# to take a real payment)
#
# The two obvious ones are the secret key and the price id. STRIPE_WEBHOOK_SECRET
# is the one that gets skipped, and skipping it costs money:
# `checkout.session.completed` is the ONLY thing that turns a paid order into Pro.
# It is delivered to /api/webhooks/stripe, and with no real signing secret every
# delivery fails verification — so the card is charged, the customer is told to
# wait, and nothing ever arrives. The dashboard reports this as `?billing=webhook`
# only once somebody has already clicked Upgrade.
#
# Stripe → Developers → Webhooks → add an endpoint for /api/webhooks/stripe,
# subscribed to `checkout.session.completed` and `charge.refunded`, then paste the
# whsec_… it shows you below. This one is a RUNTIME variable: restart the
# container, no rebuild needed. (NEXT_PUBLIC_STRIPE_PRO_PRICE_ID is the opposite —
# it is inlined at build time, so changing it does nothing without a rebuild.)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_1...

# LemonSqueezy Payments & Webhooks (Optional, when BILLING_PROVIDER=lemonsqueezy)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Litestream S3 / Cloudflare R2 Streaming Backups (Optional)
#
# The bucket is the on-switch, and it is deliberately empty. The container's
# start command is a raw shell test on it — `[ -n "$LITESTREAM_BUCKET" ]` — with
# no equivalent of the placeholder check that guards Stripe below, so any value
# here makes every start attempt a restore and a replicate. Shipping a suggested
# name such as `litesaas-db-backups` reads as configuration rather than as a
# switch nobody has thrown: the endpoint and keys beside it are still this
# file's placeholders, so the documented default deploy would reach for S3 with
# `your_r2_access_key` and never reach `next start`.
# Set all four, then restart the container — these are runtime variables, read
# by the start command on every boot, so no rebuild is involved. Setting only the
# bucket is worse than setting none: the restore and replicate both fail, the
# `&&` chain never reaches `next start`, and the container restart-loops with the
# Litestream error in the logs rather than serving the app unbacked.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=your_r2_access_key
LITESTREAM_SECRET_ACCESS_KEY=your_r2_secret_key
