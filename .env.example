# SQLite Database File Location (created automatically)
DATABASE_URL=data/app.db

# Authentication Session Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-secure-random-32-byte-hex-or-base64-string

# App Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Payments & Webhooks (Optional for billing demo)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_1...

# Litestream S3 / Cloudflare R2 Streaming Backups (Optional)
LITESTREAM_BUCKET=litesaas-db-backups
LITESTREAM_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=your_r2_access_key
LITESTREAM_SECRET_ACCESS_KEY=your_r2_secret_key
